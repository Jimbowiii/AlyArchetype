<?xml version="1.0" encoding="UTF-8"?>
<themes>
  <!-- Native Encounter Tracker styled to match Alya -->
  <theme name="encounter-counter-frame" ref="base-tabbed-frame">
    <param name="background"><image>ui-frame-red.background</image></param>
    <param name="titleAreaTop"><int>0</int></param>
    <param name="titleAreaLeft"><int>10</int></param>
    <param name="titleAreaRight"><int>-1</int></param>
    <param name="titleAreaBottom"><int>30</int></param>
    <param name="closeButtonX"><int>-24</int></param>
    <param name="closeButtonY"><int>10</int></param>
    <param name="border"><border>30,0,3,5</border></param>
    <param name="minWidth"><int>540</int></param>
    <param name="maxHeight"><int>360</int></param>

    <theme name="title" ref="title">
      <param name="font"><font>title-font</font></param>
      <param name="border"><border>0,10,0,0</border></param>
    </theme>

    <theme name="tabbedpane" ref="base-tabbed-pane">
      <param name="background"><image>ui-inner-frame-tabbed.background</image></param>
      <theme name="tabbox" ref="tabbox">
        <theme name="tabbutton" ref="tabbutton">
          <param name="background"><image>ui-tab.background</image></param>
          <param name="font"><font>pb-dark</font></param>
          <param name="border"><border>7,10,7,10</border></param>
        </theme>
      </theme>

      <theme name="container" ref="-defaults">
        <param name="border"><border>4,7,8,7</border></param>

        <theme name="encounter-counter-summary" ref="-defaults">
          <theme name="cell-right" ref="label">
            <param name="background"><image>ui-table-row.background</image></param>
            <param name="font"><font>pb-dark</font></param>
            <param name="textAlignment"><enum type="alignment">RIGHT</enum></param>
            <param name="border"><border>5</border></param>
            <param name="minWidth"><int>100</int></param>
          </theme>

          <theme name="scrollpane" ref="scrollpane">
            <param name="minHeight"><int>282</int></param>
            <theme name="vscrollbar" ref="vscrollbar"/>
            <theme name="cell" ref="cell">
              <param name="background"><image>ui-table-row.background</image></param>
              <param name="font"><font>pb-dark</font></param>
              <param name="border"><border>5,7,3,0</border></param>
            </theme>
            <theme name="cell-center" ref="cell">
              <param name="textAlignment"><enum type="alignment">CENTER</enum></param>
              <param name="minWidth"><int>130</int></param>
            </theme>
          </theme>

          <theme name="button" ref="button">
            <param name="font"><font>pb-dark</font></param>
          </theme>
          <theme name="combobox" ref="combobox">
            <param name="font"><font>pb-dark</font></param>
          </theme>
          <theme name="table" ref="table"/>
        </theme>

        <theme name="encounter-counter-history" ref="-defaults">
          <theme name="cell-right" ref="label">
            <param name="background"><image>ui-table-row.background</image></param>
            <param name="font"><font>pb-dark</font></param>
            <param name="textAlignment"><enum type="alignment">RIGHT</enum></param>
            <param name="border"><border>5</border></param>
            <param name="minWidth"><int>100</int></param>
          </theme>
          <theme name="scrollpane" ref="scrollpane">
            <param name="minHeight"><int>260</int></param>
            <theme name="vscrollbar" ref="vscrollbar"/>
          </theme>
          <theme name="table" ref="table"/>
        </theme>
      </theme>
    </theme>
  </theme>
</themes>
